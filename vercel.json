{
  "framework": "vite",
  "installCommand": "npm install --prefix frontend/s",
  "buildCommand": "npm run build --prefix frontend/s",
  "outputDirectory": "frontend/s/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://financial-research-agent-wiqb.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
